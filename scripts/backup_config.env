# Параметры базы данных
DB_NAME="homebudget"
DB_USER="myuser"
DB_HOST="localhost"
DB_PORT="5432"

# Директории
BACKUP_DIR="../backups"
LOG_FILE="../logs/backup.log"

# Настройки ротации
RETENTION_DAYS=7
MAX_BACKUPS=10
BACKUP_TIME="02:00"  # Время автоматического бэкапа 

# Уведомления (опционально)
ENABLE_NOTIFICATIONS=false
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
EMAIL_NOTIFICATIONS="admin@example.com"

# Параметры сжатия
COMPRESSION_LEVEL=6  

# Экспорт переменных для использования в скриптах
export DB_NAME DB_USER DB_HOST DB_PORT BACKUP_DIR LOG_DIR
export RETENTION_DAYS MAX_BACKUPS COMPRESSION_LEVEL